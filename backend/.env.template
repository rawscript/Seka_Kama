# ─── Seka Kama Digital Twin — Environment Template ─────────────────────────────
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ── Supabase (Required) ────────────────────────────────────────────────────────
SUPABASE_URL=your-supabase-url
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── JWT Auth (Required - Generate with: openssl rand -hex 32) ──────────────────
JWT_SECRET_KEY=your-jwt-secret-key-min-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Model Artefacts ───────────────────────────────────────────────────────────
MODELS_DIR=./models

# ── LLM Configuration ─────────────────────────────────────────────────────────
LLM_API_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=your-llm-api-key
LLM_MODEL=stepfun-ai/step-3.5-flash
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.3

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_MAX_CONNECTIONS=20
DATABASE_TIMEOUT_SECONDS=30

# ── Redis (Required for production token revocation) ──────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# ── API Configuration ─────────────────────────────────────────────────────────
API_RATE_LIMIT_REQUESTS=100
API_RATE_LIMIT_PERIOD=60
API_DEFAULT_PAGE_SIZE=50
API_MAX_PAGE_SIZE=1000

# ── Security ──────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.com
ALLOW_ALL_ORIGINS=False
TRUSTED_PROXY=false
SECURE_COOKIES=false
SESSION_TIMEOUT_MINUTES=120

# ── Monitoring & Observability ────────────────────────────────────────────────
SENTRY_DSN=
LOGGING_LEVEL=INFO
PROMETHEUS_ENABLED=false
HEALTH_CHECK_INTERVAL_SECONDS=30

# ── Email/SMTP (Required for password reset) ──────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@seka-kama.io

# ── Feature Flags ─────────────────────────────────────────────────────────────
FEATURE_LIVE_MODE_ENABLED=true
FEATURE_SCENARIO_SIMULATION_ENABLED=true
FEATURE_AI_NARRATIVES_ENABLED=true
FEATURE_REAL_TIME_UPDATES_ENABLED=false
