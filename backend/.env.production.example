# ─── Seka Kama Digital Twin — Production Environment ──────────────────────────
# NEVER commit this file to version control. Use secrets management (Railway, Vercel, etc.)

# ── Supabase (Production) ──────────────────────────────────────────────────────
SUPABASE_URL=${SUPABASE_URL}
SUPABASE_SERVICE_ROLE_KEY=${SUPABASE_SERVICE_ROLE_KEY}

# ── JWT Auth ──────────────────────────────────────────────────────────────────
# Must be at least 32 characters, generate with: openssl rand -hex 32
JWT_SECRET_KEY=${JWT_SECRET_KEY}
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Model Artefacts ───────────────────────────────────────────────────────────
MODELS_DIR=./models

# ── LLM Configuration ─────────────────────────────────────────────────────────
# Use environment-specific LLM endpoints
LLM_API_URL=${LLM_API_URL}
LLM_API_KEY=${LLM_API_KEY}
LLM_MODEL=stepfun-ai/step-3.5-flash
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.3

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_MAX_CONNECTIONS=20
DATABASE_TIMEOUT_SECONDS=30

# ── API Configuration ─────────────────────────────────────────────────────────
API_RATE_LIMIT_REQUESTS=100
API_RATE_LIMIT_PERIOD=60
API_DEFAULT_PAGE_SIZE=50
API_MAX_PAGE_SIZE=1000

# ── Security ──────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://seka-kama.vercel.app
ALLOW_ALL_ORIGINS=False
TRUSTED_PROXY=true
SECURE_COOKIES=true
SESSION_TIMEOUT_MINUTES=120

# ── Monitoring & Observability ────────────────────────────────────────────────
SENTRY_DSN=${SENTRY_DSN}
LOGGING_LEVEL=INFO
PROMETHEUS_ENABLED=true
HEALTH_CHECK_INTERVAL_SECONDS=30

# ── Cache ─────────────────────────────────────────────────────────────────────
REDIS_URL=${REDIS_URL}
CACHE_TTL_SECONDS=300

# ── Email/SMTP ────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=${SMTP_USER}
SMTP_PASSWORD=${SMTP_PASSWORD}
EMAIL_FROM=noreply@seka-kama.io

# ── Feature Flags ─────────────────────────────────────────────────────────────
FEATURE_LIVE_MODE_ENABLED=true
FEATURE_SCENARIO_SIMULATION_ENABLED=true
FEATURE_AI_NARRATIVES_ENABLED=true
FEATURE_REAL_TIME_UPDATES_ENABLED=false  # Enable when infrastructure ready


# ── SendGrid Email Service (Free Tier: 100 emails/day) ─────────────────────────
SENDGRID_API_KEY=${SENDGRID_API_KEY}
# Optional: If not using SendGrid, configure SMTP below
# SENDGRID_API_KEY=


# ── Webhook Fallback (for n8n, Zapier, Make.com automation) ───────────────────
# CONTACT_WEBHOOK_URL=${CONTACT_WEBHOOK_URL}
# Example: https://hooks.zapier.com/hooks/catch/123456/abc123/