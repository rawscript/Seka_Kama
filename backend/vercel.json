{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd backend && pip install -r requirements.txt",
  "outputDirectory": "backend",
  "functions": {
    "backend/main.py": {
      "runtime": "python3.11",
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": "backend/models/**"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "backend/main.py"
    }
  ],
  "env": {
    "ENVIRONMENT": "production",
    "PYTHON_VERSION": "3.11"
  }
}
